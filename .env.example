APP_ENV=production
DATABASE_URL=postgresql://APP_USER:PASSWORD@HOST/DB?sslmode=require
ADMIN_DATABASE_URL=postgresql://OWNER:PASSWORD@HOST/DB?sslmode=require
APP_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
ALLOWED_HOSTS=YOUR-SERVICE.onrender.com
COOKIE_SECURE=true
DEMO_QUICK_LOGIN=false
GEOBLOCK_ENABLED=false
GEOBLOCK_DENY_COUNTRIES=KG
TRUSTED_PROXY_CIDRS=
ORGANIZER_NAME=Организатор учебного проекта B bank
# AI is off until an operator sets a compatible provider, model and private key.
AI_ENABLED=false
# openai_chat | openai_responses | anthropic | gemini
AI_API_FORMAT=gemini
# Empty base URL and label select defaults for the chosen format.
AI_PROVIDER_LABEL=
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite
AI_TIMEOUT_SECONDS=15
AI_MAX_OUTPUT_TOKENS=600
AI_TOKEN_PARAMETER=max_tokens
AI_JSON_MODE=true
AI_HOURLY_LIMIT=20
AI_DAILY_BUDGET_REQUESTS=200
# Shown only after handoff, never in the public catalogue or frontend bundle.
SUPPORT_PHONE_PRIMARY=996220715205
SUPPORT_PHONE_SECONDARY=996995393911
